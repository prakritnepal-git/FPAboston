<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Attention Deficit | FP&A Summit Boston</title>
  <style>
    :root {
      --bg-primary: #060a12;
      --bg-secondary: #0e1628;
      --bg-card: rgba(20, 31, 54, 0.86);
      --bg-card-solid: #16223b;
      --bg-glass: rgba(12, 19, 34, 0.82);
      --text-primary: #f8fafc;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --accent-blue: #38bdf8;
      --accent-indigo: #818cf8;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;
      --accent-rose: #f43f5e;
      --accent-purple: #c084fc;
      --border-color: rgba(148, 163, 184, 0.2);
      --glow-blue: 0 0 32px rgba(56, 189, 248, 0.24);
      --shadow: 0 22px 48px -14px rgba(0, 0, 0, 0.72);
    }

    body.light-mode {
      --bg-primary: #f1f5f9;
      --bg-secondary: #e2e8f0;
      --bg-card: rgba(255, 255, 255, 0.95);
      --bg-card-solid: #ffffff;
      --bg-glass: rgba(255, 255, 255, 0.9);
      --text-primary: #0f172a;
      --text-secondary: #334155;
      --text-muted: #64748b;
      --accent-blue: #0284c7;
      --accent-indigo: #4f46e5;
      --accent-emerald: #059669;
      --accent-amber: #d97706;
      --accent-rose: #e11d48;
      --accent-purple: #7e22ce;
      --border-color: rgba(15, 23, 42, 0.15);
      --glow-blue: 0 10px 28px rgba(2, 132, 199, 0.15);
      --shadow: 0 16px 36px -12px rgba(15, 23, 42, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
      background-color: var(--bg-primary);
      background-image:
        radial-gradient(circle at 10% 15%, rgba(56, 189, 248, 0.09) 0%, transparent 42%),
        radial-gradient(circle at 90% 85%, rgba(129, 140, 248, 0.09) 0%, transparent 42%),
        linear-gradient(rgba(148, 163, 184, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(148, 163, 184, 0.03) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 48px 48px, 48px 48px;
      color: var(--text-primary);
      height: 100vh;
      width: 100vw;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      user-select: none;
      font-variant-numeric: tabular-nums;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Presenter HUD */
    header.hud-bar {
      height: 50px;
      background: var(--bg-glass);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 28px;
      font-size: 0.85rem;
      z-index: 20;
      flex-shrink: 0;
      transition: margin-top 0.3s ease, opacity 0.3s ease;
    }

    body.hud-hidden header.hud-bar {
      margin-top: -50px;
      opacity: 0;
      pointer-events: none;
    }

    .hud-left, .hud-center, .hud-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .badge-live {
      background: rgba(16, 185, 129, 0.15);
      color: var(--accent-emerald);
      border: 1px solid rgba(16, 185, 129, 0.45);
      padding: 4px 12px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.78rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--accent-emerald);
      box-shadow: 0 0 8px var(--accent-emerald);
    }

    .timer-pill {
      background: var(--bg-card-solid);
      border: 1px solid var(--border-color);
      padding: 5px 14px;
      border-radius: 8px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }

    .step-badge-hud {
      background: rgba(56, 189, 248, 0.15);
      border: 1px solid var(--accent-blue);
      color: var(--accent-blue);
      padding: 5px 12px;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.82rem;
    }

    .hud-btn {
      background: var(--bg-card-solid);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .hud-btn:hover { border-color: var(--accent-blue); }
    .hud-btn.active {
      background: var(--accent-indigo);
      border-color: var(--accent-indigo);
      color: #fff;
    }

    /* Progress Track */
    .progress-track {
      height: 4px;
      background: var(--bg-secondary);
      width: 100%;
      flex-shrink: 0;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent-blue), var(--accent-indigo), var(--accent-emerald));
      width: 5%;
      transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 0 12px var(--accent-blue);
    }

    /* Balanced Stage Container */
    main.stage {
      flex: 1;
      position: relative;
      overflow-y: auto;
      padding: 24px 48px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slide {
      display: none;
      width: 100%;
      max-width: 1580px;
      margin: auto;
      flex-direction: column;
      gap: 20px;
      animation: slideEnter 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .slide.active {
      display: flex;
    }

    .slide-header {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    @keyframes slideEnter {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Progressive Clicker Build States */
    .build-item {
      transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                  box-shadow 0.3s ease,
                  border-color 0.3s ease,
                  filter 0.3s ease;
    }

    .build-item.step-future {
      opacity: 0.16;
      transform: translateY(6px) scale(0.992);
      filter: grayscale(80%);
      pointer-events: none;
    }

    .build-item.step-past {
      opacity: 0.92;
      transform: translateY(0) scale(1);
      filter: none;
    }

    .build-item.step-current {
      opacity: 1;
      transform: translateY(0) scale(1.006);
      border-color: var(--accent-blue) !important;
      box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.55), var(--glow-blue), var(--shadow) !important;
      filter: none;
      z-index: 5;
    }

    /* STAGE TYPOGRAPHY SCALE */
    .slide-kicker {
      color: var(--accent-blue);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: clamp(0.88rem, 1vw, 1rem);
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    h1.slide-title {
      font-size: clamp(2.1rem, 2.85vw, 3.05rem);
      line-height: 1.12;
      font-weight: 800;
      letter-spacing: -0.025em;
    }

    p.slide-subtitle {
      font-size: clamp(1.08rem, 1.28vw, 1.28rem);
      color: var(--text-secondary);
      max-width: 1320px;
      line-height: 1.44;
    }

    /* Layout Grids */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: stretch; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; align-items: stretch; }

    .card {
      background: var(--bg-card);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 24px 26px;
      box-shadow: var(--shadow);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .card-title {
      font-size: clamp(1.2rem, 1.4vw, 1.45rem);
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      line-height: 1.25;
    }

    .body-copy {
      font-size: clamp(1.02rem, 1.15vw, 1.18rem);
      color: var(--text-secondary);
      line-height: 1.48;
    }

    .body-copy strong {
      color: var(--text-primary);
    }

    /* ================================================================= */
    /* SLIDE 1: EXPANSIVE BENTO COVER                                    */
    /* ================================================================= */
    .cover-hero-banner {
      background: linear-gradient(135deg, rgba(22, 35, 62, 0.95) 0%, rgba(12, 19, 36, 0.98) 100%);
      border: 1px solid var(--border-color);
      border-left: 6px solid var(--accent-blue);
      border-radius: 18px;
      padding: 28px 34px;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 32px;
      align-items: center;
      box-shadow: var(--shadow);
    }

    .cover-meta-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 16px;
    }

    .cover-pill {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      padding: 8px 16px;
      border-radius: 999px;
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text-primary);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .track-item {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 14px 18px;
      display: flex;
      gap: 14px;
      align-items: flex-start;
    }

    .track-num {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      font-size: 0.92rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .track-item strong {
      font-size: clamp(1.04rem, 1.18vw, 1.2rem);
      color: var(--text-primary);
      display: block;
      margin-bottom: 3px;
    }

    .track-item span {
      font-size: clamp(0.94rem, 1.05vw, 1.06rem);
      color: var(--text-secondary);
      line-height: 1.4;
      display: block;
    }

    .roadmap-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      padding: 16px 22px;
    }

    .roadmap-step {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 0.96rem;
      line-height: 1.35;
    }

    /* ================================================================= */
    /* SLIDE 2: 40-SLIDE SORTER MOCKUP & LIVE APP MOCKUP                 */
    /* ================================================================= */
    .wireframe-window {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .wireframe-bar {
      background: rgba(0, 0, 0, 0.35);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-color);
      font-size: 0.88rem;
      color: var(--text-secondary);
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .win-dots { display: flex; gap: 6px; }
    .win-dots span { width: 10px; height: 10px; border-radius: 50%; }

    .ppt-sorter-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    .mini-ppt-slide {
      background: #16223b;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 8px 10px;
      height: 82px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .mini-ppt-slide.lost-slide {
      border: 2px solid var(--accent-rose);
      background: rgba(244, 63, 94, 0.16);
      box-shadow: 0 0 18px rgba(244, 63, 94, 0.35);
    }

    .mini-ppt-header {
      font-size: 0.74rem;
      font-weight: 800;
      color: var(--text-muted);
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid rgba(148, 163, 184, 0.18);
      padding-bottom: 3px;
    }

    .overload-fill-bar, .lever-fill-1, .lever-fill-2 {
      width: 0%;
      height: 100%;
      border-radius: 99px;
      transition: width 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .overload-fill-bar { background: linear-gradient(90deg, #f59e0b, #f43f5e); }

    /* ================================================================= */
    /* SLIDE 3: ONE-SHOT RADIAL GAUGES & HIGH-CONTRAST OODA TABLE        */
    /* ================================================================= */
    .gauge-card {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 18px;
      padding: 18px 20px;
    }

    .gauge-svg {
      width: 86px;
      height: 86px;
      flex-shrink: 0;
    }

    .gauge-ring-anim {
      transition: stroke-dashoffset 1.2s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mult-bar-anim {
      transition: height 1.1s cubic-bezier(0.22, 1, 0.36, 1), y 1.1s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .ooda-loop-Diagram-box {
      grid-column: span 2;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 18px 22px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .ooda-track-outer {
      border: 1.5px dashed rgba(244, 63, 94, 0.6);
      background: rgba(244, 63, 94, 0.07);
      border-radius: 12px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .ooda-track-inner {
      border: 2px solid var(--accent-emerald);
      background: rgba(16, 185, 129, 0.11);
      border-radius: 12px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      flex-wrap: wrap;
      box-shadow: 0 0 22px rgba(16, 185, 129, 0.14);
    }

    .ooda-node-chain {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ooda-node-pill {
      background: var(--bg-secondary);
      border: 1px solid rgba(16, 185, 129, 0.5);
      color: var(--text-primary);
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 0.88rem;
      font-weight: 800;
    }

    .ooda-row {
      display: grid;
      grid-template-columns: 112px 1fr 1fr;
      gap: 12px;
      margin-bottom: 10px;
      align-items: stretch;
      border-radius: 10px;
      padding: 4px;
      border: 1px solid transparent;
    }

    .ooda-stage-pill {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-left: 4px solid var(--accent-blue);
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 10px 12px;
    }

    .ooda-stage-pill span {
      font-size: 0.74rem;
      color: var(--accent-blue);
      font-weight: 800;
      letter-spacing: 0.06em;
    }

    .ooda-stage-pill strong {
      font-size: 1.05rem;
      color: var(--text-primary);
    }

    .ooda-cell {
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 0.94rem;
      line-height: 1.38;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .ooda-cell.legacy {
      background: var(--bg-secondary);
      border-left: 3px solid var(--accent-rose);
      color: var(--text-secondary);
    }

    .ooda-cell.frontier {
      background: rgba(16, 185, 129, 0.09);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-left: 3px solid var(--accent-emerald);
      color: var(--text-primary);
    }

    .ooda-cell strong {
      color: var(--text-primary);
      display: block;
      margin-bottom: 2px;
      font-size: 0.98rem;
    }

    /* ================================================================= */
    /* SLIDE 4: 4 ERAS WITH LARGE TYPOGRAPHY & BANDWIDTH BARS            */
    /* ================================================================= */
    .era-col-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-top: 5px solid var(--accent-blue);
      border-radius: 16px;
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 18px;
    }

    .era-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .time-split-bar {
      height: 26px;
      width: 100%;
      background: var(--bg-secondary);
      border-radius: 99px;
      overflow: hidden;
      display: flex;
      font-size: 0.82rem;
      font-weight: 800;
      color: #fff;
    }

    .time-prep, .time-strat {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 0%;
      transition: width 1s cubic-bezier(0.22, 1, 0.36, 1);
      overflow: hidden;
      white-space: nowrap;
    }

    .time-prep { background: var(--accent-rose); }
    .time-strat { background: var(--accent-emerald); }

    /* ================================================================= */
    /* SLIDE 6: FACTORY PIPELINE                                         */
    /* ================================================================= */
    .factory-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 14px;
    }

    .roi-pill-group { display: flex; gap: 12px; flex-wrap: wrap; }

    .roi-pill {
      background: rgba(16, 185, 129, 0.14);
      border: 1px solid var(--accent-emerald);
      color: var(--accent-emerald);
      padding: 8px 18px;
      border-radius: 999px;
      font-size: 0.92rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .roi-pill.secondary {
      background: rgba(56, 189, 248, 0.14);
      border-color: var(--accent-blue);
      color: var(--accent-blue);
    }

    .pipeline-flow {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      position: relative;
    }

    .stage-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      padding: 20px;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
      box-shadow: var(--shadow);
    }

    .stage-card.gen-ai { border-top: 5px solid var(--accent-purple); }
    .stage-card.det-excel { border-top: 5px solid var(--accent-emerald); }
    .stage-card.compiler-ai {
      border-top: 5px solid var(--accent-blue);
      background: linear-gradient(180deg, rgba(56, 189, 248, 0.1) 0%, var(--bg-card) 100%);
    }

    .stage-card:not(:last-child)::after {
      content: "➔";
      position: absolute;
      right: -16px;
      top: 50%;
      transform: translateY(-50%);
      width: 28px;
      height: 28px;
      background: var(--bg-card-solid);
      border: 1px solid var(--accent-blue);
      color: var(--accent-blue);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      z-index: 6;
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
    }

    .mini-flow-diagram {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 0.84rem;
      font-weight: 700;
      gap: 4px;
    }

    .engine-tag {
      font-size: 0.78rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 99px;
      text-transform: uppercase;
    }

    .engine-tag.purple { background: rgba(192, 132, 252, 0.16); color: #d8b4fe; border: 1px solid rgba(192, 132, 252, 0.45); }
    .engine-tag.emerald { background: rgba(16, 185, 129, 0.16); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.45); }
    .engine-tag.blue { background: rgba(56, 189, 248, 0.16); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.45); }

    .stage-step-badge {
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 4px 10px;
      border-radius: 6px;
      background: var(--bg-secondary);
      color: var(--text-primary);
    }

    .stage-title {
      font-size: 1.2rem;
      font-weight: 800;
      margin-bottom: 6px;
      color: var(--text-primary);
    }

    .stage-body {
      font-size: 0.96rem;
      color: var(--text-secondary);
      line-height: 1.44;
    }

    .sub-module {
      background: var(--bg-secondary);
      border-left: 3px solid var(--accent-emerald);
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 0.9rem;
      line-height: 1.38;
      margin-bottom: 8px;
    }

    .sub-module strong {
      color: var(--text-primary);
      display: block;
