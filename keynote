    function animateCounter(elId, targetVal, suffix = '%', duration = 1000) {
      const el = document.getElementById(elId);
      if (!el) return;
      const startTime = performance.now();
      function tick(now) {
        const progress = Math.min(1, (now - startTime) / duration);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${Math.round(targetVal * eased)}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    function triggerOneShotAnimations() {
      // Slide 2 One-Shot Animations
      if (currentSlide === 1) {
        if (currentStep >= 1 && !s2Step1Animated) {
          s2Step1Animated = true;
          setTimeout(() => {
            document.getElementById('s2-overload-bar').style.width = '92%';
          }, 80);
        }
        if (currentStep >= 2 && !s2Step2Animated) {
          s2Step2Animated = true;
          setTimeout(() => {
            document.getElementById('s2-lever-1').style.width = '68%';
            document.getElementById('s2-lever-2').style.width = '54%';
            const bars = [
              { id: 's2-bar-1', y: 48, h: 28 },
              { id: 's2-bar-2', y: 36, h: 40 },
              { id: 's2-bar-3', y: 22, h: 54 },
              { id: 's2-bar-4', y: 10, h: 66 }
            ];
            bars.forEach(b => {
              const rect = document.getElementById(b.id);
              rect.setAttribute('y', b.y);
              rect.setAttribute('height', b.h);
            });
          }, 80);
        }
      }

      // Slide 3 One-Shot Gauge Sweep & Number Count-Up
      if (currentSlide === 2 && !s3GaugesAnimated) {
        s3GaugesAnimated = true;
        setTimeout(() => {
          document.getElementById('g-ring-15').style.strokeDashoffset = String(201 * (1 - 0.15));
          document.getElementById('g-ring-63').style.strokeDashoffset = String(201 * (1 - 0.63));
          document.getElementById('g-ring-60').style.strokeDashoffset = String(201 * (1 - 0.60));

          const multBar = document.getElementById('g-bar-mult');
          multBar.setAttribute('y', '14');
          multBar.setAttribute('height', '54');

          animateCounter('g-num-15', 15, '%', 1050);
          animateCounter('g-num-63', 63, '%', 1150);
          animateCounter('g-num-60', 60, '%', 1150);
        }, 80);
      }

      // Slide 4 One-Shot Era Bandwidth Bar Animations
      if (currentSlide === 3) {
        const splits = [
          { a: 'era-bar-1a', wa: '85%', b: 'era-bar-1b', wb: '15%' },
          { a: 'era-bar-2a', wa: '70%', b: 'era-bar-2b', wb: '30%' },
          { a: 'era-bar-3a', wa: '55%', b: 'era-bar-3b', wb: '45%' },
          { a: 'era-bar-4a', wa: '15%', b: 'era-bar-4b', wb: '85%' }
        ];
        const idx = currentStep - 1;
        if (!s4ErasAnimated[idx]) {
          s4ErasAnimated[idx] = true;
          setTimeout(() => {
            document.getElementById(splits[idx].a).style.width = splits[idx].wa;
            document.getElementById(splits[idx].b).style.width = splits[idx].wb;
          }, 60);
        }
      }

      // Slide 8 One-Shot Operating Model Bandwidth Bars
      if (currentSlide === 7 && !s8BarsAnimated) {
        s8BarsAnimated = true;
        setTimeout(() => {
          document.getElementById('s8-bar-leg1').style.width = '55%';
          document.getElementById('s8-bar-leg2').style.width = '30%';
          document.getElementById('s8-bar-leg3').style.width = '15%';
          document.getElementById('s8-bar-fr1').style.width = '15%';
          document.getElementById('s8-bar-fr2').style.width = '45%';
          document.getElementById('s8-bar-fr3').style.width = '40%';
        }, 80);
      }
    }

    function getCumulativeStepsCompleted() {
      let count = 0;
      for (let i = 0; i < currentSlide; i++) count += slideMaxSteps[i];
      return count + currentStep;
    }

    function applySlideStepVisuals() {
      slides.forEach((s, idx) => s.classList.toggle('active', idx === currentSlide));

      const activeSlideEl = slides[currentSlide];
      const maxSteps = slideMaxSteps[currentSlide];
      const items = activeSlideEl.querySelectorAll('.build-item');

      items.forEach(item => {
        const itemStep = parseInt(item.getAttribute('data-step'), 10);
        item.classList.remove('step-future', 'step-past', 'step-current');
        if (itemStep < currentStep) item.classList.add('step-past');
        else if (itemStep === currentStep) item.classList.add('step-current');
        else item.classList.add('step-future');
      });

      triggerOneShotAnimations();

      // Slide 5 (index 4): Dynamic SVG Cash-Flow Chart & Automated Stress Breach on Step 4
      if (currentSlide === 4) {
        const sandboxCard = document.getElementById('s5-sandbox-card');
        const badge = document.getElementById('s5-sim-mode-badge');
        if (currentStep <= 3) {
          document.getElementById('capex-outlay').value = 1200;
          document.getElementById('capex-inflow').value = 480;
          document.getElementById('capex-delay').value = 3;
          badge.textContent = 'Step 3: Base Case (Passes)';
          badge.style.borderColor = 'var(--accent-emerald)';
          badge.style.color = 'var(--accent-emerald)';
          runGuardrailSim();
        } else if (currentStep === 4) {
          sandboxCard.classList.remove('step-past');
          sandboxCard.classList.add('step-current');
          document.getElementById('capex-outlay').value = 2100;
          document.getElementById('capex-inflow').value = 425;
          document.getElementById('capex-delay').value = 9;
          badge.textContent = 'Step 4: Stress Case (Breach!)';
          badge.style.borderColor = 'var(--accent-rose)';
          badge.style.color = 'var(--accent-rose)';
          runGuardrailSim();
        }
      }

      // Slide 7 (index 6): Illuminate Bounded Layer Plates on Left
      if (currentSlide === 6) {
        for (let p = 1; p <= 4; p++) {
          const plate = document.getElementById(`iso-plate-${p}`);
          if (plate) {
            plate.style.opacity = p <= currentStep ? '1' : '0.28';
            plate.style.transform = p === currentStep ? 'scale(1.03)' : 'scale(1)';
            plate.style.boxShadow = p === currentStep ? '0 0 18px rgba(56,189,248,0.4)' : 'none';
          }
        }
      }

      document.getElementById('slide-counter').textContent =
        `Slide ${currentSlide + 1} / ${slides.length} • Step ${currentStep} / ${maxSteps}`;

      const completed = getCumulativeStepsCompleted();
      document.getElementById('progress-fill').style.width = `${(completed / totalDeckSteps) * 100}%`;
      document.getElementById('slide-pace').textContent = activeSlideEl.getAttribute('data-pace');
      document.getElementById('notes-slide-title').textContent =
        `Speaker Notes — Slide ${currentSlide + 1} (Step ${currentStep} of ${maxSteps})`;
      document.getElementById('notes-content').innerHTML = speakerNotes[currentSlide];
    }

    function nextStepOrSlide() {
      const maxSteps = slideMaxSteps[currentSlide];
      if (currentStep < maxSteps) {
        currentStep++;
        applySlideStepVisuals();
      } else if (currentSlide < slides.length - 1) {
        currentSlide++;
        currentStep = 1;
        applySlideStepVisuals();
      }
    }

    function prevStepOrSlide() {
      if (currentStep > 1) {
        currentStep--;
        applySlideStepVisuals();
      } else if (currentSlide > 0) {
        currentSlide--;
        currentStep = slideMaxSteps[currentSlide];
        applySlideStepVisuals();
      }
    }

    function toggleFullScreen() {
      const btn = document.getElementById('btn-fullscreen');
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().then(() => {
          btn.textContent = '⛶ Exit (F)';
          btn.classList.add('active');
          window.focus();
        }).catch(() => {});
      } else {
        document.exitFullscreen().then(() => {
          btn.textContent = '⛶ Full (F)';
          btn.classList.remove('active');
          window.focus();
        }).catch(() => {});
      }
    }

    function toggleHud() { document.body.classList.toggle('hud-hidden'); }
    function toggleBlackout() { document.getElementById('blackout-overlay').classList.toggle('active'); }

    function toggleNotes() {
      document.getElementById('notes-drawer').classList.toggle('open');
      document.getElementById('btn-notes').classList.toggle('active');
    }

    function toggleTheme() { document.body.classList.toggle('light-mode'); }

    function runGuardrailSim() {
      const outlay = parseFloat(document.getElementById('capex-outlay').value);
      const inflow = parseFloat(document.getElementById('capex-inflow').value);
      const delay = parseFloat(document.getElementById('capex-delay').value);

      document.getElementById('capex-outlay-val').textContent = `$${outlay.toLocaleString()}K`;
      document.getElementById('capex-inflow-val').textContent = `$${inflow.toLocaleString()}K/yr`;
      document.getElementById('capex-delay-val').textContent = `${delay} Mos`;

      const delayFactor = 1 - (delay / 36);
      const effectiveAnnual = inflow * 0.88 * delayFactor;
      const payback = outlay / effectiveAnnual;
      const npv = Math.round((effectiveAnnual * 3.65) - outlay);
      const irr = (((effectiveAnnual / outlay) * 1.38) - 0.115) * 100;
      const cleanIrr = Math.max(-5, Math.min(45, irr)).toFixed(1);

      const pass = parseFloat(cleanIrr) >= 14.0 && npv > 0 && payback <= 3.2;

      const irrEl = document.getElementById('sim-irr');
      const npvEl = document.getElementById('sim-npv');
      const pbEl = document.getElementById('sim-payback');
      const box = document.getElementById('sim-guardrail-box');

      irrEl.textContent = `${cleanIrr}%`;
      npvEl.textContent = `${npv >= 0 ? '+' : ''}$${npv}K`;
      pbEl.textContent = `${payback.toFixed(1)} Yrs`;

      irrEl.style.color = pass ? 'var(--accent-emerald)' : 'var(--accent-rose)';
      npvEl.style.color = npv >= 0 ? 'var(--accent-blue)' : 'var(--accent-rose)';

      const zeroY = 62;
      const pts = [];
      const xCoords = [39, 77, 115, 153, 191];
      for (let yr = 1; yr <= 5; yr++) {
        const cumCash = (effectiveAnnual * yr) - outlay;
        const scaledH = Math.min(46, Math.max(-32, Math.round(cumCash / 28)));
        const bar = document.getElementById(`cf-bar-${yr}`);
        if (scaledH >= 0) {
          bar.setAttribute('y', zeroY - scaledH);
          bar.setAttribute('height', Math.max(4, scaledH));
          bar.setAttribute('fill', pass ? '#10b981' : '#f59e0b');
          pts.push(`${xCoords[yr - 1]},${zeroY - scaledH}`);
        } else {
          bar.setAttribute('y', zeroY);
          bar.setAttribute('height', Math.max(4, Math.abs(scaledH)));
          bar.setAttribute('fill', '#f43f5e');
          pts.push(`${xCoords[yr - 1]},${zeroY + Math.abs(scaledH)}`);
        }
      }
      document.getElementById('cf-curve').setAttribute('points', pts.join(' '));

      if (pass) {
        box.className = 'guardrail-banner guardrail-pass';
        box.innerHTML = '<span>✅ AUTO-APPROVED FOR STAGE-GATE: Meets all embedded FP&A hurdle guardrails.</span>';
      } else {
        box.className = 'guardrail-banner guardrail-fail';
        box.innerHTML = '<span>🛑 GUARDRAIL BREACH: Fails 14% IRR floor or 3.2-Yr payback ceiling. Escalate to FP&A review.</span>';
      }
    }

    function openDemoModal(url) {
      document.getElementById('demo-modal').classList.add('open');
      switchModalUrl(url);
    }

    function switchModalUrl(url) {
      document.getElementById('demo-iframe').src = url;
      document.getElementById('modal-url-label').textContent = url;
      document.getElementById('modal-ext-link').href = url;
    }

    function closeDemoModal() {
      document.getElementById('demo-modal').classList.remove('open');
      document.getElementById('demo-iframe').src = 'about:blank';
      window.focus();
    }

    let timerSeconds = 0;
    let timerInterval = null;

    function toggleTimer() {
      const statusEl = document.getElementById('timer-status');
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
        statusEl.textContent = '▶';
      } else {
        statusEl.textContent = '⏸';
        timerInterval = setInterval(() => {
          timerSeconds++;
          const mins = String(Math.floor(timerSeconds / 60)).padStart(2, '0');
          const secs = String(timerSeconds % 60).padStart(2, '0');
          document.getElementById('timer-display').textContent = `${mins}:${secs} / 45:00`;
        }, 1000);
      }
    }

    window.addEventListener('keydown', (e) => {
      const blackout = document.getElementById('blackout-overlay');
      const modalOpen = document.getElementById('demo-modal').classList.contains('open');

      if (blackout.classList.contains('active')) {
        e.preventDefault();
        blackout.classList.remove('active');
        return;
      }

      if (['ArrowRight', 'PageDown', 'ArrowDown', ' ', 'Enter'].includes(e.key)) {
        if (!modalOpen) { e.preventDefault(); nextStepOrSlide(); }
      } else if (['ArrowLeft', 'PageUp', 'ArrowUp', 'Backspace'].includes(e.key)) {
        if (!modalOpen) { e.preventDefault(); prevStepOrSlide(); }
      } else if (e.key === '1') {
        e.preventDefault();
        openDemoModal('https://prakritnepal-git.github.io/capexanalyzer/');
      } else if (e.key === '2') {
        e.preventDefault();
        openDemoModal('https://prakritnepal-git.github.io/Q226_competitive_analysis/');
      } else if (e.key === '.' || e.key.toLowerCase() === 'b') {
        if (!modalOpen) { e.preventDefault(); toggleBlackout(); }
      } else if (e.key.toLowerCase() === 'f') {
        e.preventDefault(); toggleFullScreen();
      } else if (e.key.toLowerCase() === 'h') {
        e.preventDefault(); toggleHud();
      } else if (e.key.toLowerCase() === 'n') {
        e.preventDefault(); toggleNotes();
      } else if (e.key.toLowerCase() === 't') {
        e.preventDefault(); toggleTimer();
      } else if (e.key.toLowerCase() === 'l') {
        e.preventDefault(); toggleTheme();
      } else if (e.key === 'Escape') {
        if (modalOpen) closeDemoModal();
      }
    });

    applySlideStepVisuals();
  </script>
